# Copy to .env (git-ignored) and fill in. Never commit .env.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
MODEL=gemini-3.5-flash-lite

# Demo app (per level)
SOURCE_LATENCY_MS=100
ROW_CAP=500
CACHE_ENABLED=true
CACHE_TTL_MIN=60
A2A_NOTES_ENABLED=true
MAX_AGENT_LLM_CALLS=25

# Harness
MAX_CLIENT_LLM_CALLS=25
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # optional: local Jaeger
